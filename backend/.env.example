# Copiar a .env y ajustar si hace falta.
# Los valores por defecto ya coinciden con el Postgres que levanta docker-compose.yml.

# Orígenes permitidos por CORS, separados por coma (sin espacios extra necesarios)
CORS_ORIGIN=http://localhost:3000

# Base de datos de desarrollo (levantada con `pnpm docker:up`)
DATABASE_URL="postgresql://mokka:mokka@localhost:5432/mokka_cafe?schema=public"

# Pool de conexiones (usado por el driver adapter PrismaPg)
DATABASE_POOL_MAX=10
DATABASE_POOL_IDLE_TIMEOUT_MS=30000
DATABASE_POOL_CONNECTION_TIMEOUT_MS=5000

NODE_ENV=development
PORT=8080
