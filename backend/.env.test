# Orígenes permitidos por CORS, separados por coma (sin espacios extra necesarios)
CORS_ORIGIN=http://localhost:3000

# Base de datos exclusiva para tests (E2E/integración). Se trunca entre tests.
DATABASE_URL="postgresql://mokka:mokka@localhost:5432/mokka_cafe_test?schema=public"

DATABASE_POOL_MAX=5
DATABASE_POOL_IDLE_TIMEOUT_MS=10000
DATABASE_POOL_CONNECTION_TIMEOUT_MS=5000

NODE_ENV=test
PORT=8081
